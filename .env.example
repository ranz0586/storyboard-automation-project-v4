# ---- Google Gemini (googlePalmApi in n8n) ----
# Comma-separated list; each key is used at most once per cooldown window,
# so more keys = more calls per window. Legacy single GEMINI_API_KEY still works.
GEMINI_API_KEYS=
# Per-key cooldown in ms (default 300000 = 5 min; 0 disables rotation waits).
GEMINI_KEY_COOLDOWN_MS=300000

# Primary + fallback models, mirroring the workflow's Gemini nodes.
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# ---- Airtable ----
# A personal access token (pat...), NOT a legacy key... API key (retired Feb 2024).
# Needs data.records:read + data.records:write scopes and the base added as a resource.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appnBhwjEiHrAZpaa
AIRTABLE_TABLE_PROJECTS=Projects
AIRTABLE_TABLE_IDEAS=Ideas
AIRTABLE_TABLE_SCRIPTS=Scripts
AIRTABLE_TABLE_STORYBOARDS=Storyboard
# The current live base has a hidden leading BOM only on Ideas.title.
# Scripts.video_id and Storyboard.storyboard_id have plain names.
AIRTABLE_IDEA_TITLE_HAS_BOM=true
AIRTABLE_SCRIPT_VIDEO_ID_HAS_BOM=false
AIRTABLE_STORYBOARD_ID_HAS_BOM=false

# Server-side coercion of near-miss values on writes (numeric strings, new
# select options). Default on; set false to get strict type errors instead.
AIRTABLE_TYPECAST=true

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=6626378722

# ---- Server ----
PORT=3000
# Dashboard login uses the Airtable Users table and HttpOnly session cookies.
AIRTABLE_TABLE_USERS=Users
SESSION_TTL_MS=28800000
# Defaults to true when NODE_ENV=production. Enable for HTTPS deployments.
# SESSION_COOKIE_SECURE=true
# Shared filesystem directory prevents concurrent duplicate username creation.
USER_LOCK_DIR=data/user-locks
# Per-client fixed-window limit for expensive pipeline requests.
PIPELINE_RATE_LIMIT_MAX=5
PIPELINE_RATE_LIMIT_WINDOW_MS=60000
# Higher ceiling for authenticated dashboard polling/read requests.
API_READ_RATE_LIMIT_MAX=120
# Process-local pipeline queue limits. Dashboard, scheduled, and
# in-process storyboard work share it. Default keeps one expensive pipeline
# active while allowing up to ten validated requests to wait.
PIPELINE_MAX_CONCURRENCY=1
PIPELINE_MAX_QUEUED=10

# Weekly project scheduler. Configuration is managed by the dashboard and
# persisted in this small local state file; use a persistent disk in hosting.
SCHEDULER_POLL_MS=60000
SCHEDULE_TIMEZONE=Asia/Singapore
SCHEDULE_STATE_PATH=data/schedules.json
# Durable run history; interrupted runs can be retried and scheduled occurrences replay.
RUN_STATE_PATH=data/runs.json
# Shared filesystem path for cross-process per-idea script generation locks.
SCRIPT_LOCK_DIR=data/script-locks

# Number of concepts the Idea Agent should produce (workflow uses 10).
IDEA_CONCEPT_COUNT=10

# In-process storyboard poll interval in ms for the server (0/unset = off).
# Alternative: cron `npm run storyboard`. The n8n Schedule Trigger used 15 min.
STORYBOARD_POLL_MS=0

# ---- yt-dlp Trend Scout (optional; degrades gracefully if missing) ----
# Path to the yt-dlp binary (must be installed separately: pip install yt-dlp).
YTDLP_PATH=yt-dlp
# Search results per planned query (max 5 queries, 50 videos total).
YTDLP_SEARCH_LIMIT=15
# Per-query hard timeout in ms.
YTDLP_TIMEOUT_MS=60000
# Set false to skip the Trend Scout stage entirely.
TREND_SCOUT_ENABLED=true
